generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BranchKey {
  MARINES
  NAVY
}

enum ApplicationStatus {
  PENDING
  VERIFIED
  INTERVIEWING
  ACCEPTED
  DENIED
}

enum LinkCategory {
  GAME
  GROUP
  TRAINING
  DISCORD
  COMMUNITY
  CUSTOM
}

model User {
  id             String       @id @default(cuid())
  displayName    String
  timezone       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  robloxAccount  RobloxAccount?
  applications   Application[]
}

model RobloxAccount {
  id                 String   @id @default(cuid())
  userId             String   @unique
  robloxUserId       Int      @unique
  robloxUsername     String
  avatarUrl          String?
  verificationStatus Boolean  @default(false)
  verificationCode   String?
  verifiedAt         DateTime?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id                  String            @id @default(cuid())
  userId              String
  branchId            String
  robloxUsername      String
  robloxUserId        Int
  ageConfirmed        Boolean
  priorExperience     String
  reasonForJoining    String
  activityLevel       String
  additionalNotes     String?
  status              ApplicationStatus @default(PENDING)
  adminNotes          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch              Branch            @relation(fields: [branchId], references: [id])
}

model Branch {
  id                  String        @id @default(cuid())
  key                 BranchKey     @unique
  name                String
  description         String
  requiredGroupId     Int
  joinGroupUrl        String
  enlistmentOpen      Boolean       @default(true)
  requirementsText    String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  applications        Application[]
  links               Link[]
}

model Link {
  id          String       @id @default(cuid())
  title       String
  url         String
  category    LinkCategory
  visible     Boolean      @default(true)
  sortOrder   Int          @default(0)
  branchId    String?
  branch      Branch?      @relation(fields: [branchId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String
  details     String
  createdAt   DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
